{
  "name": "qiaomu-reader-english",
  "version": "4.4.0",
  "description": "基于 Qiaomu Reader 的 Obsidian 英文阅读器，支持 EPUB、PDF、Markdown 等文本阅读、悬浮查词、选区查词和 Spaced Repetition 复习卡片。",
  "homepage": "https://github.com/dashell7/qiaomu-reader-english",
  "repository": {
    "type": "git",
    "url": "https://github.com/dashell7/qiaomu-reader-english.git"
  },
  "bugs": {
    "url": "https://github.com/dashell7/qiaomu-reader-english/issues"
  },
  "main": "main.js",
  "type": "module",
  "scripts": {
    "postinstall": "node patch-pdfjs.cjs",
    "dev": "node esbuild.config.mjs",
    "build": "node scripts/generate-pdf-cmaps.mjs && node esbuild.config.mjs production && node patch-pdfjs.cjs",
    "build:community": "node scripts/generate-pdf-cmaps.mjs && node esbuild.config.mjs production --profile=community && node scripts/verify-release.mjs --profile=community",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "build:books": "node scripts/build-starter-books.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "epub",
    "fb2",
    "pdf",
    "reader",
    "highlights"
  ],
  "author": "向阳乔木",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "jsdom": "^29.1.1",
    "obsidian": "latest"
  },
  "dependencies": {
    "foliate-js": "^1.0.1",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "pdfjs-dist": "^6.2.108"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "minimatch@3.1.5": {
      "brace-expansion": "2.0.2"
    },
    "tar": "^7.5.22"
  }
}
